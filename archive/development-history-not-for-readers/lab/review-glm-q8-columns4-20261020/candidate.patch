+            const __m256 d = _mm256_set_m128(
+                _mm_set1_ps(xd1 * GGML_CPU_FP16_TO_FP32(y[c][ib + 1].d)),
+                _mm_set1_ps(xd0 * GGML_CPU_FP16_TO_FP32(y[c][ib].d)));
