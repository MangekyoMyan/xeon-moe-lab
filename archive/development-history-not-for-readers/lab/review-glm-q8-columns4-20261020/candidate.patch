+            const __m128i y01 = _mm_loadu_si128((const __m128i *) (y[c][ib].qs + 16));
+            const __m128i y10 = _mm_loadu_si128((const __m128i *) y[c][ib + 1].qs);
+            const __m128i y11 = _mm_loadu_si128((const __m128i *) (y[c][ib + 1].qs + 16));
