+        const __m128i x01 = _mm_loadu_si128((const __m128i *) (x[ib].qs + 16));
+        const __m128i x10 = _mm_loadu_si128((const __m128i *) x[ib + 1].qs);
+        const __m128i x11 = _mm_loadu_si128((const __m128i *) (x[ib + 1].qs + 16));
