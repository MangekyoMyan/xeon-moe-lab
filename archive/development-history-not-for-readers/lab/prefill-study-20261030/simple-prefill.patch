+static void prefill_swap(xv_pool & pool, xv_weights & bank, const int64_t * counts) {
+    auto & conf=config();
+    if(!conf.prefill_swap_gain || conf.validate)return;
+    int incoming=-1,victim=-1;
+    for(int e=0;e<bank.experts;++e) {
+        if(bank.slots[e]<0 && counts[e]>0 && (incoming<0 || counts[e]>counts[incoming]))incoming=e;
+        if(bank.slots[e]>=0 && (victim<0 || counts[e]<counts[victim]))victim=e;
+    }
+    if(incoming<0 || victim<0 || counts[incoming]-counts[victim]<conf.prefill_swap_gain)return;
+    // Shared weights cannot change while any pool still has a reader.
+    for(const auto & item:conf.pools) {
+        auto & other=*item.second;
+        if(other.pending || other.mlp_active)return;
+        std::lock_guard<std::mutex> guard(other.work_mutex);
+        if(!other.work_done || other.work_ready)return;
+    }
+    const auto started=xv_clock::now();
+    const int slot=bank.slots[victim];
+    const size_t row=ggml_row_size(GGML_TYPE_Q8_0,bank.k);
+    const size_t source_bytes=row*bank.m,destination_bytes=row*bank.gpu_m;
+    pool.prepare_staging(source_bytes);
+    pool.copy_expert(bank.weights,slot*destination_bytes,
+                     (const char *)bank.source_data+incoming*source_bytes,source_bytes,0);
+    // Publish only after the copy, including for another pool's CUDA stream.
+    ggml_backend_synchronize(pool.backend);
+    bank.slots[victim]=-1;bank.slots[incoming]=slot;
+    ++pool.prefill_swaps;pool.prefill_swap_bytes+=source_bytes;
+    pool.prefill_extra_hits+=counts[incoming]-counts[victim];
+    pool.prefill_swap_ms+=elapsed_ms(started);
+}
