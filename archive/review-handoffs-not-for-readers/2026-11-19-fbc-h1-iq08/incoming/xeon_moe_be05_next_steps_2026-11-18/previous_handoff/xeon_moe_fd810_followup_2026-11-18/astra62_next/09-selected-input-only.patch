+// The single-token route uses column slot % n_inputs, including broadcast inputs.
+static bool ggml_mmid_input_has_compact_slot(const struct ggml_tensor * ids, int64_t input, int64_t n_inputs,
+        int64_t n_experts, const void * const * compact_experts) {
+    for (int64_t slot = input; slot < ids->ne[0]; slot += n_inputs) {
+        const int32_t expert = *(const int32_t *) ((const char *) ids->data + slot*ids->nb[0]);
+        if (expert >= 0 && expert < n_experts && compact_experts[expert]) {
+            return true;
+        }
+    }
+    return false;
+}
