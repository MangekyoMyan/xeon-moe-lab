-// placeholder implementation for Apple targets
-void quantize_row_q8_K(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
-    quantize_row_q8_K_ref(x, y, k);
+#if defined(__AVX__) && !defined(__AVX2__)
+static inline float q8k_max_8(__m256 x) {
+    __m128 t = _mm_max_ps(_mm256_castps256_ps128(x), _mm256_extractf128_ps(x, 1));
+    t = _mm_max_ps(t, _mm_movehl_ps(t, t));
+    return _mm_cvtss_f32(_mm_max_ss(t, _mm_movehdup_ps(t)));
+}
+#endif
+
+void quantize_row_q8_K(const float * GGML_RESTRICT x, void * GGML_RESTRICT out, int64_t k) {
+#if defined(__AVX__) && !defined(__AVX2__)
+    assert(k % QK_K == 0);
+    if (_MM_GET_ROUNDING_MODE() != _MM_ROUND_NEAREST) {
+        quantize_row_q8_K_ref(x, out, k);
+        return;
+    }
+    block_q8_K * y = out;
+    const __m256 minus_zero = _mm256_set1_ps(-0.0f);
+    for (int64_t b = 0; b < k/QK_K; ++b) {
+        const float * row = x + b*QK_K;
+        __m256 largest = _mm256_setzero_ps();
+        __m256 smallest = _mm256_setzero_ps();
+        __m256 unordered = _mm256_setzero_ps();
+        for (int j = 0; j < QK_K; j += 8) {
+            const __m256 v = _mm256_loadu_ps(row + j);
+            largest = _mm256_max_ps(v, largest);
+            smallest = _mm256_min_ps(v, smallest);
+            unordered = _mm256_or_ps(unordered, _mm256_cmp_ps(v, v, _CMP_UNORD_Q));
+        }
+        const float positive = q8k_max_8(largest);
+        const float negative_abs = q8k_max_8(_mm256_xor_ps(smallest, minus_zero));
+        if (_mm256_movemask_ps(unordered) || !isfinite(positive) || !isfinite(negative_abs)) {
+            quantize_row_q8_K_ref(row, y + b, QK_K);
+            continue;
+        }
+        if (positive == 0.f && negative_abs == 0.f) {
+            y[b].d = 0.f;
+            memset(y[b].qs, 0, QK_K);
+            continue;
+        }
+        float extremum = positive > negative_abs ? positive : -negative_abs;
+        if (positive == negative_abs) {
+            // The reference picks the first occurrence when opposite signs tie.
+            for (int j = 0; j < QK_K; ++j) {
+                if (fabsf(row[j]) == positive) {
+                    extremum = row[j];
+                    break;
+                }
+            }
+        }
+        const float scale = -127.f/extremum;
+        if (!isfinite(scale)) {
+            quantize_row_q8_K_ref(row, y + b, QK_K);
+            continue;
+        }
+        const __m256 vscale = _mm256_set1_ps(scale);
+        for (int g = 0; g < QK_K/16; ++g) {
+            const float * in = row + 16*g;
+            const __m256i q0 = _mm256_cvtps_epi32(_mm256_mul_ps(vscale, _mm256_loadu_ps(in)));
+            const __m256i q1 = _mm256_cvtps_epi32(_mm256_mul_ps(vscale, _mm256_loadu_ps(in + 8)));
+            const __m128i h0 = _mm_packs_epi32(_mm256_castsi256_si128(q0), _mm256_extractf128_si256(q0, 1));
+            const __m128i h1 = _mm_packs_epi32(_mm256_castsi256_si128(q1), _mm256_extractf128_si256(q1, 1));
+            const __m128i bytes = _mm_packs_epi16(h0, h1);
+            _mm_storeu_si128((__m128i *) (y[b].qs + 16*g), bytes);
+            const __m128i biased = _mm_xor_si128(bytes, _mm_set1_epi8(-128));
+            const __m128i sums = _mm_sad_epu8(biased, _mm_setzero_si128());
+            const __m128i total = _mm_add_epi64(sums, _mm_unpackhi_epi64(sums, sums));
+            y[b].bsums[g] = (int16_t) (_mm_cvtsi128_si32(total) - 16*128);
+        }
+        y[b].d = 1.f/scale;
+    }
+#else
+    quantize_row_q8_K_ref(x, out, k);
+#endif
 }
 
