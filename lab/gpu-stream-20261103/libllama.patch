     }
 
     load_tensors_hadamard();
+
+    const char * expert_dma_env = std::getenv("GGML_CUDA_REGISTER_HOST");
+    if (expert_dma_env && std::strcmp(expert_dma_env, "1") == 0) {
+#if defined(__linux__)
+        if (!ml.use_mmap) {
+            throw std::runtime_error("expert DMA requires mmap-backed weights");
+        }
+        const long page_size = sysconf(_SC_PAGESIZE);
+        if (page_size <= 0) throw std::runtime_error("expert DMA: page size unavailable");
+
+        std::vector<std::vector<xeon_expert_dma::range>> ranges(pimpl->mappings.size());
+        for (const auto & layer : layers) {
+            for (const auto * tensor : {layer.ffn_gate_up_exps, layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps}) {
+                if (!tensor || !tensor->buffer || !ggml_backend_buffer_is_host(tensor->buffer) ||
+                    ggml_backend_buffer_get_usage(tensor->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) continue;
+                if (ml.lazy.has(tensor)) throw std::runtime_error("expert DMA does not support lazy weights");
+                const auto * weight = ml.get_weight(tensor->name);
+                if (!weight || weight->idx >= pimpl->mappings.size() || !pimpl->mappings[weight->idx]) {
+                    throw std::runtime_error("expert DMA: tensor has no mapping");
+                }
+                const auto & mapping = pimpl->mappings[weight->idx];
+                const size_t bytes = ggml_nbytes(tensor);
+                if (weight->offs > mapping->size() || bytes > mapping->size()-weight->offs ||
+                    tensor->data != static_cast<uint8_t *>(mapping->addr())+weight->offs) {
+                    throw std::runtime_error("expert DMA: tensor mapping mismatch");
+                }
+                ranges[weight->idx].emplace_back(weight->offs, weight->offs+bytes);
+            }
+        }
+        size_t count = 0;
+        size_t bytes = 0;
+        for (size_t i = 0; i < ranges.size(); ++i) {
+            ranges[i] = xeon_expert_dma::page_ranges(std::move(ranges[i]), pimpl->mappings[i]->size(), page_size);
+            count += ranges[i].size();
+            for (const auto & range : ranges[i]) bytes += range.second-range.first;
+        }
+        if (count > 0) {
+            xeon_expert_dma::register_fn acquire = nullptr;
+            xeon_expert_dma::unregister_fn release = nullptr;
+            for (const auto & device : devices) {
+                auto reg = ggml_backend_dev_backend_reg(device.dev);
+                if (!reg || std::strcmp(ggml_backend_reg_name(reg), "CUDA") != 0) continue;
+                acquire = reinterpret_cast<xeon_expert_dma::register_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_register_host_buffer"));
+                release = reinterpret_cast<xeon_expert_dma::unregister_fn>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_unregister_host_buffer"));
+                if (acquire && release) break;
+            }
+            if (!acquire || !release) throw std::runtime_error("expert DMA: CUDA registration API unavailable");
+            pimpl->expert_dma.reserve(count);
+            LLAMA_LOG_WARN("expert DMA: registering %zu ranges, %.2f GiB of existing host weights\n", count, bytes/1073741824.0);
+            for (size_t i = 0; i < ranges.size(); ++i) {
+                for (const auto & range : ranges[i]) {
+                    void * base = static_cast<uint8_t *>(pimpl->mappings[i]->addr())+range.first;
+                    if (!pimpl->expert_dma.add(base, range.second-range.first, acquire, release)) {
+                        throw std::runtime_error("expert DMA registration failed; disable GGML_CUDA_REGISTER_HOST to restore normal loading");
+                    }
+                }
+            }
+            LLAMA_LOG_WARN("expert DMA: registration complete; original host mappings retained\n");
+        }
+#else
+        throw std::runtime_error("expert DMA experiment requires Linux");
