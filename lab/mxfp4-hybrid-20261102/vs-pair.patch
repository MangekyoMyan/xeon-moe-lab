+        const block_q8_0 * x2, const block_q8_0 * x3,
+        __m256 * sum01, __m256 * sum23) {
+    const __m128i lookup = _mm_setr_epi8(0,1,2,3,4,6,8,12,0,-1,-2,-3,-4,-6,-8,-12);
+    const __m128i mask = _mm_set1_epi8(15);
+    const __m128i bits = _mm_loadu_si128((const __m128i *)w->qs);
+    const __m128i q0 = _mm_shuffle_epi8(lookup, _mm_and_si128(bits, mask));
+    const __m128i q1 = _mm_shuffle_epi8(lookup, _mm_and_si128(_mm_srli_epi16(bits,4), mask));
