+    const __m256 scale = _mm256_set_m128(
+        _mm_set1_ps(dw * GGML_CPU_FP16_TO_FP32(x1->d)),
+        _mm_set1_ps(dw * GGML_CPU_FP16_TO_FP32(x0->d)));
+    return _mm256_mul_ps(scale, values);
