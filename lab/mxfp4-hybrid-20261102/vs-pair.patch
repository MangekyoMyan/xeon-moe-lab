+MX4_INLINE __m256 ggml_mx4_pair_partial(
+        __m128i q0, __m128i q1, __m128i a0, __m128i a1, float dw,
+        const block_q8_0 * x0, const block_q8_0 * x1) {
+    const __m128i ones = _mm_set1_epi16(1);
+    const __m128i y00 = _mm_sign_epi8(_mm_loadu_si128((const __m128i *)x0->qs), q0);
+    const __m128i lo0 = _mm_maddubs_epi16(a0, y00);
+    const __m128i y01 = _mm_sign_epi8(_mm_loadu_si128((const __m128i *)(x0->qs + 16)), q1);
+    const __m128i p0 = _mm_madd_epi16(_mm_add_epi16(lo0, _mm_maddubs_epi16(a1, y01)), ones);
+    const __m128i y10 = _mm_sign_epi8(_mm_loadu_si128((const __m128i *)x1->qs), q0);
+    const __m128i lo1 = _mm_maddubs_epi16(a0, y10);
+    const __m128i y11 = _mm_sign_epi8(_mm_loadu_si128((const __m128i *)(x1->qs + 16)), q1);
+    const __m128i p1 = _mm_madd_epi16(_mm_add_epi16(lo1, _mm_maddubs_epi16(a1, y11)), ones);
